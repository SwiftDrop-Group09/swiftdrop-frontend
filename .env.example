# Public configuration; never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api
# Public Google Web OAuth client ID; configure its exact authorized origin.
VITE_GOOGLE_WEB_CLIENT_ID=
# Local YARP target. Preserve /api and configure trusted public host/protocol
# forwarding for the secure browser Identity cookie/CSRF contract.
DEV_GATEWAY_TARGET=http://localhost:5000
