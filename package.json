{
  "name": "swiftdrop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "node scripts/preview.mjs",
    "lint": "react-router typegen && eslint . --max-warnings=0",
    "typecheck": "react-router typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@react-router/node": "8.4.0",
    "@tanstack/react-query": "5.104.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "zod": "4.6.7",
    "isbot": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.0.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
